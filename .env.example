# Copy this file to .env and fill in your own values.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

WAYFORPAY_MERCHANT_ACCOUNT=test_merchant
WAYFORPAY_SECRET_KEY=replace_with_your_secret_key
WAYFORPAY_DOMAIN_NAME=your-domain.com
WAYFORPAY_SERVICE_URL=https://your-domain.com/payments/wayforpay/your-secret-path

PAYMENT_WEBHOOK_SECRET=your-webhook-secret
APP_HOST=0.0.0.0
APP_PORT=8080

# Время удержания слота без оплаты (в минутах). По умолчанию 30.
RESERVATION_TTL_MINUTES=30

