# Copy this file to .env and fill in your own secrets.
# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WayForPay
WAYFORPAY_MERCHANT_ACCOUNT=your_merchant_account
WAYFORPAY_SECRET_KEY=your_wayforpay_secret_key
WAYFORPAY_DOMAIN_NAME=your_domain.com
WAYFORPAY_SERVICE_URL=https://your_domain.com/payments/wayforpay/your_secret
WAYFORPAY_DEBUG=0
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# App
APP_HOST=0.0.0.0
APP_PORT=8080

# Booking/payment defaults
RESERVATION_TTL_MINUTES=30
DEPOSIT_AMOUNT_UAH=200
PLATFORM_COMMISSION_PERCENT=10

# Admins for hidden /test_pay command
ADMIN_IDS=123456789

# Railway or local database path
RAILWAY_PUBLIC_DOMAIN=your_domain.com
DATABASE_FILE=bookings.db
